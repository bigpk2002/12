# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (อย่า commit .env เข้า git)

# ฟรีที่ https://twelvedata.com/pricing (สมัครแล้วเอา API key จาก Dashboard)
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# ฟรีถาวร ไม่ต้องผูกบัตร จาก https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# จาก LINE Official Account Manager > Messaging API > Channel access token
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# User ID ของตัวเอง (ดูวิธีหาใน README.md)
LINE_USER_ID=your_line_user_id_here
